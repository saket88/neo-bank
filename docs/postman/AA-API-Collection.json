{
  "info": {
    "name": "India Stack Account Aggregator API",
    "description": "Postman collection for testing Account Aggregator APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9080/api/v1/aa"
    },
    {
      "key": "customerId",
      "value": "9876543210@neobank"
    },
    {
      "key": "consentId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "consentHandle",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Consent Management",
      "item": [
        {
          "name": "Create Consent Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"consentHandle\", jsonData.consentHandle);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ver\": \"1.0\",\n  \"timestamp\": \"2024-01-15T10:30:00Z\",\n  \"txnid\": \"f35761ac-4a18-11e8-96ff-0277a9fbfedc\",\n  \"consentDetail\": {\n    \"consentStart\": \"2024-01-15T00:00:00Z\",\n    \"consentExpiry\": \"2024-12-31T23:59:59Z\",\n    \"consentMode\": \"VIEW\",\n    \"fetchType\": \"PERIODIC\",\n    \"consentTypes\": [\"TRANSACTIONS\", \"PROFILE\", \"SUMMARY\"],\n    \"fiTypes\": [\"DEPOSIT\"],\n    \"dataConsumer\": {\n      \"id\": \"FIU-001\",\n      \"type\": \"FIU\"\n    },\n    \"customer\": {\n      \"id\": \"{{customerId}}\"\n    },\n    \"purpose\": {\n      \"code\": \"101\",\n      \"text\": \"Wealth management service\"\n    },\n    \"fiDataRange\": {\n      \"from\": \"2023-01-01T00:00:00Z\",\n      \"to\": \"2024-01-15T00:00:00Z\"\n    },\n    \"dataLife\": {\n      \"unit\": \"MONTH\",\n      \"value\": 6\n    },\n    \"frequency\": {\n      \"unit\": \"MONTH\",\n      \"value\": 1\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Consent",
              "host": ["{{baseUrl}}"],
              "path": ["Consent"]
            }
          }
        },
        {
          "name": "Get Consent by Handle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Consent/handle/{{consentHandle}}",
              "host": ["{{baseUrl}}"],
              "path": ["Consent", "handle", "{{consentHandle}}"]
            }
          }
        },
        {
          "name": "Get Consent by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Consent/{{consentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["Consent", "{{consentId}}"]
            }
          }
        },
        {
          "name": "Approve Consent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ver\": \"1.0\",\n  \"timestamp\": \"2024-01-15T10:35:00Z\",\n  \"txnid\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"consentStatus\": {\n    \"status\": \"ACTIVE\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Consent/{{consentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["Consent", "{{consentId}}"]
            }
          }
        }
      ]
    },
